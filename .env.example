# Copy this file to .env for local development.
# On Render, set these under your Web Service -> Environment tab instead
# (render.yaml marks the secret ones as sync:false so Render prompts for
# them rather than storing defaults in git).

# --- Server ---
PORT=3000
NODE_ENV=development
# Restrict this in production, e.g. https://yourdomain.com
ALLOWED_ORIGIN=*

# --- Merchant / terminal identity (shown on the receipt) ---
MERCHANT_NAME=Demo Merchant
GXPAY_TERMINAL_ID=CR100-SCRP-001

# --- GxPay gateway ---
# mock    = simulate GxPay locally, no credentials needed (default, good for testing)
# sandbox = call GxPay's sandbox/dev environment
# live    = call GxPay's production environment
GXPAY_MODE=mock

GXPAY_BASE_URL=https://api.gxpay.net
GXPAY_API_KEY=
GXPAY_API_SECRET=
GXPAY_MERCHANT_ID=
GXPAY_TERMINAL_ID=

# bearer | hmac - see services/gxpayClient.js buildHeaders()
GXPAY_SIGNING=bearer
GXPAY_TIMEOUT_MS=20000

# Optional: shared secret to verify inbound GxPay webhooks, if/when GxPay
# confirms it sends async status callbacks (POST /api/payments/webhook/gxpay)
GXPAY_WEBHOOK_SECRET=

# Set to true only for local mock-mode debugging - never in an environment
# that touches real cardholder data.
VERBOSE_CARD_LOGGING=false

# --- Database (Supabase) ---
# Optional. Leave both blank to use the zero-setup in-memory store (gone on
# every restart/redeploy - fine for local dev/testing, not production).
# Set both to persist transactions and the item/service catalog in a real
# Postgres database instead:
#   1. Create a project at https://supabase.com
#   2. Run db/schema.sql in the project's SQL Editor (Supabase dashboard ->
#      SQL Editor -> New query -> paste the file -> Run)
#   3. Project Settings -> API Keys -> copy the Project URL and the
#      Secret key (sb_secret_..., NOT the Publishable key sb_publishable_...)
#      below. Supabase renamed anon->Publishable and service_role->Secret
#      in 2025 - same distinction, easy to grab the wrong one since they're
#      right next to each other. Using the wrong key doesn't error - it
#      just silently returns empty results (Row Level Security filters
#      everything out), which looks identical to "the table is empty".
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
